# Copy to .env.local and fill in. Never commit the filled-in version.
# On Vercel these go in Settings → Environment Variables, not in a file.

# ---------- database (required) ----------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------- first-run admin passwords ----------
# Read once by db/seed.js, hashed immediately, never stored in plain text.
# Prefer `npm run db:passwords`, which issues one-time passwords instead.
SEED_UMAMA_PASSWORD=
SEED_ASHBA_PASSWORD=

# Random 32+ character string used to sign session cookies.
SESSION_SECRET=

# ---------- order notification email ----------
# Where new-order alerts go.
ORDER_NOTIFICATION_EMAIL=sheglamofficialpk@gmail.com

# The address mail is sent FROM. Must be one the provider lets you use.
SMTP_FROM=SHEGLAM PK <orders@sheglampk.online>

# Used to build the "View order in the admin portal" link in the email,
# and the customer's tracking link. No trailing slash.
SITE_BASE_URL=https://sheglampk.online
ADMIN_BASE_URL=https://sheglampk.online

# Pick ONE provider and fill in its keys.
#   resend  — HTTP API, simplest on Vercel, generous free tier
#   brevo   — HTTP API
#   smtp    — any SMTP server, including Gmail with an App Password
#   none    — the default: orders still work, notifications are recorded
#             but not sent, and can be sent later from the admin portal
MAIL_PROVIDER=none

# --- if MAIL_PROVIDER=resend ---
# Create a key at resend.com, verify sheglampk.online as a sending domain.
RESEND_API_KEY=

# --- if MAIL_PROVIDER=brevo ---
BREVO_API_KEY=

# --- if MAIL_PROVIDER=smtp ---
# Gmail: turn on 2-step verification, then create an App Password.
# Your normal Gmail password will not work and must not be used here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---------- scheduled notification retry ----------
# A long random string. The retry endpoint requires it (or an admin
# session), so nobody else can drive your mail provider.
CRON_SECRET=

# ---------- automatic storefront updates ----------
# Product pages are static HTML built from the database. After a product,
# stock or homepage change the portal calls this Vercel Deploy Hook, and
# the live shop is rebuilt in about a minute. Treat it like a password:
# anyone holding the URL can redeploy the site. Create it with
#   vercel deploy-hooks create shop-rebuild --ref main
# and set it on Vercel only. Leave it empty locally.
DEPLOY_HOOK_URL=
