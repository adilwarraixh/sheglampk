# Copy to .env.local and fill in. Never commit the filled-in version.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Initial admin passwords — read ONCE by the seed script, then hashed.
# Set these in Vercel → Settings → Environment Variables, not here.
SEED_UMAMA_PASSWORD=
SEED_ASHBA_PASSWORD=

# Random 32+ char string used to sign session cookies.
SESSION_SECRET=
