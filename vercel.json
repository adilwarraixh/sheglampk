{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/notifications/retry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/refresh",
      "schedule": "5 * * * *"
    }
  ]
}
