# Admin credentials — NEVER commit or deploy
data/admin-auth.json

# Local order store and automatic catalogue backups
data/orders.json
data/backups/

# OS / editor noise
.DS_Store
Thumbs.db
*.tmp

# Deploy build output (regenerated by deploy-prepare.js)
dist/

# Secrets — NEVER commit. Database URLs, API keys, tokens.
.env
.env.*
!.env.example
.neon
neon.local.*

# Handover credentials — generated locally, never committed
HANDOVER.txt

# Dependencies — restored by `npm install` (Vercel runs it at build time)
node_modules/

# Generated deployment secrets — never commit
DEPLOY-ENV.txt
